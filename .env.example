# 复制为 .env 后按需修改；全部可选，默认值见 README
LAW_HOST=0.0.0.0
LAW_PORT=8001
# LAW_DATA_DIR=./data
# LAW_DB_PATH=./data/law_data.db
# LAW_CHROMA_PATH=./data/legal_vector_db
# LAW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# LAW_COLLECTION_NAME=chinese_laws

# 检查更新（网页顶部提示条 / tools/check_update.py 共用）
# LAW_REPO=tlgzs/china-law-search       # 默认从 git remote origin 推断
# LAW_UPDATE_CHECK_TTL=3600             # 版本检查缓存秒数，0=每次真查
# LAW_UPDATE_CHECK_ON_START=1           # 0=启动时不查
# LAW_AUTO_UPDATE=0                     # 1=查到新版直接装，不等用户点
# GITHUB_TOKEN=                         # 可选，未认证 60 次/小时，配了 5000
