#!/bin/bash
# 双击更新：检查 GitHub 上有没有新的法条库，有就自动下载安装
# 与 update.sh 的差别只有一件事：跑完停一下，别让窗口自己关掉。
cd "$(dirname "$0")" || exit 1

echo "======================================"
echo "  壹律法条 · 检查数据更新"
echo "======================================"
echo ""

./update.sh
code=$?

echo ""
read -r -p "按回车键关闭窗口…" _
exit $code
