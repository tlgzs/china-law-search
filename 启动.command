#!/bin/bash
# 双击启动：自动准备环境 → 启动本地法规检索服务 → 打开浏览器
#
# 准备工作（选 Python 版本、建虚拟环境、装依赖、挑端口）只有一份实现，
# 在 start.sh 里；这里只负责双击场景的横幅和「跑完别让窗口自己关掉」。
cd "$(dirname "$0")" || exit 1

echo "======================================"
echo "  壹律法条 · 本地法规检索服务启动中"
echo "======================================"

./start.sh
code=$?

echo ""
read -r -p "按回车键关闭窗口…" _
exit $code
